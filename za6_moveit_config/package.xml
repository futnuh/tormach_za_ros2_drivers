<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>za6_moveit_config</name>
  <version>0.3.0</version>
  <description>Tormach ZA6 MoveIt configuration and launch</description>
  <maintainer email="jmorris@tormach.com">John Morris</maintainer>

  <license>BSD</license>

  <url type="website">https://tormach.com/</url>
  <url type="bugtracker">https://github.com/tormach/za/issues</url>
  <url type="repository">https://github.com/tormach/za</url>

  <author email="jmorris@tormach.com">John Morris</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies for custom servo node -->
  <depend>moveit_servo</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <exec_depend>joy</exec_depend>

  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_planners_chomp</exec_depend>
  <exec_depend>pilz_industrial_motion_planner</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>

  <!-- controller_manager just needed for demo (HAL has its own) -->
  <exec_depend>controller_manager</exec_depend>
  <!-- for launch files -->
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_ros_warehouse</exec_depend>
  <exec_depend>moveit_setup_assistant</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_common</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>warehouse_ros_sqlite</exec_depend>
  <exec_depend>za6_description</exec_depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_copyright</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
